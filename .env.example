# Copy to .env (never commit .env). Required: MONGO_URI, JWT_SECRET.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/traintrack
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Comma-separated browser origins allowed cross-origin. Leave empty when the UI is served by this app.
CORS_ORIGIN=
# Set to 1 behind a reverse proxy (Render/Railway) so rate limiting sees real client IPs.
TRUST_PROXY=0
ML_SERVICE_URL=http://localhost:5000
ML_API_KEY=
# Used only by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# SEED_DEMO_USERS=true
# DEMO_PASSWORD=
